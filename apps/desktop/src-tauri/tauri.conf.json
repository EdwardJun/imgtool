{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImgTool",
  "version": "0.1.0",
  "identifier": "com.imgtool.desktop",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar --release && pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "图片工具",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/imgtool"],
    "shortDescription": "图片压缩、裁剪、格式转换，支持 MCP 接入 Agent"
  }
}
